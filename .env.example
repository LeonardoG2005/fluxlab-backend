# Copia este archivo como `.env` para desarrollo local.
# En Railway configura estas variables en: Service -> Variables.
# NUNCA publiques secrets (service role key, password, etc.) en el frontend.

# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CORS (recomendado en producción)
# Lista separada por comas. Ej: https://tu-app.vercel.app,https://tu-dominio.com
CORS_ORIGINS=http://localhost:5173
# true|false
CORS_CREDENTIALS=false

# Swagger
# En prod se deshabilita por defecto salvo que lo habilites explícitamente.
# true|false
SWAGGER_ENABLED=true

# Database (TypeORM)
# Opción A (recomendada si quieres una sola variable):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=

# Opción B (actual del proyecto - Supabase Postgres)
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=
SUPABASE_PASSWORD=

# SSL para Postgres (en producción se asume true si no se define)
# true|false
DB_SSL=true

# Supabase (API)
SUPABASE_PROJECT_ID=
SUPABASE_URL=

# Backend-only secret (NO exponer en frontend)
SUPABASE_SERVICE_ROLE_KEY=

# (Actualmente no se usa en el código, pero se mantiene por compatibilidad)
JWT_SECRET=
